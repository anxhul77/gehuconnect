{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts",
    "app/components/Inputform/FormButton.tsx",
    "app/(drawer)/(tabs)/communities/[communityId]",
    "app/(drawer)/voice",
    "app/channels",
    "app/components/community/create"
  ]
}